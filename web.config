<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Tipos de audio que o IIS nao serve por padrao -->
      <remove fileExtension=".flac" /><mimeMap fileExtension=".flac" mimeType="audio/flac" />
      <remove fileExtension=".opus" /><mimeMap fileExtension=".opus" mimeType="audio/ogg" />
      <remove fileExtension=".oga"  /><mimeMap fileExtension=".oga"  mimeType="audio/ogg" />
      <remove fileExtension=".m4a"  /><mimeMap fileExtension=".m4a"  mimeType="audio/mp4" />
      <remove fileExtension=".aac"  /><mimeMap fileExtension=".aac"  mimeType="audio/aac" />
      <remove fileExtension=".weba" /><mimeMap fileExtension=".weba" mimeType="audio/webm" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <!-- Permite nomes de arquivo com "+" (ex.: "AC+DC"). Se der erro 500.19, apague este bloco. -->
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>
  </system.webServer>
</configuration>
